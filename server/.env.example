# Application
APP_NAME=GDG Flutter Workshop Backend
ENVIRONMENT=development
LOG_LEVEL=INFO

# Local development: PostgreSQL exposed by the Docker command in README.md.
# Deployment: replace this with the provider-supplied Cloudflare Hyperdrive URL.
# Do not commit real credentials. SQLModel expects a SQLAlchemy-compatible URL.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/flutter_wars
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Required for Module B participant JWTs. Generate a unique high-entropy value
# for every deployed environment; never commit a real secret.
JWT_SECRET_KEY=replace-with-a-unique-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=60
# Required for production Google ID-token audience validation.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback
