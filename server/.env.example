# Copy to .env for local development. NEVER commit the real .env.
# Used by plain uvicorn / pytest (NOT by Cloudflare Workers — those use bindings/secrets).
# The app reads these from the process environment; it does not auto-load .env.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# These DB_* options are consumed by app/infra helpers, not the current app engine.
DB_CONNECT_TIMEOUT_SECONDS=5
DB_APPLICATION_NAME=flutter-wars
# PostgreSQL tests reset tables. Use separate disposable databases with these suffixes.
# Local dev/tests/migrations use psycopg; the Worker uses pg8000 via Hyperdrive.
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/flutter_modules_test?sslmode=require
MIGRATION_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/flutter_migration_test?sslmode=require
