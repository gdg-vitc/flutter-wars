# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Environment / secrets — never commit real values
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
*.pem
*.key
credentials.json

# Cloudflare / Wrangler / pywrangler (generated)
.wrangler/
node_modules/
dist*/
python_modules/
.venv-workers/
# Worker dependency export, generated by pywrangler from uv.lock/pyproject.
# uv.lock is the authoritative project lock; pylock.toml is a build artifact.
pylock.toml

# Test / coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.db
