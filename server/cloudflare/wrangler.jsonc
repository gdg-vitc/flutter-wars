{
  // Cloudflare Python Worker for the whole backend. Fill in the two IDs for your
  // account (docs/deployment.md), or deploy with your own copy:
  //   uv run pywrangler deploy --config wrangler.local.jsonc   (git-ignored)
  "name": "flutter-wars-api",
  "main": "src/worker.py",
  "account_id": "<CLOUDFLARE_ACCOUNT_ID>",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["python_workers"],
  "placement": { "region": "aws:ap-southeast-1" },
  "hyperdrive": [
    // Hyperdrive config pointing at Neon's DIRECT host, caching disabled.
    { "binding": "HYPERDRIVE", "id": "<HYPERDRIVE_CONFIG_ID>" }
  ],
  // Non-secret Module A settings. Secrets (JWT_SECRET_KEY, GOOGLE_OAUTH_CLIENT_SECRET)
  // are set with `wrangler secret put`, never here.
  "vars": {
    "APP_NAME": "Flutter Wars backend",
    "ENVIRONMENT": "production",
    "LOG_LEVEL": "INFO",
    "DATABASE_CONNECT_TIMEOUT_SECONDS": "10",
    "DATABASE_POOL_SIZE": "1",
    "DATABASE_MAX_OVERFLOW": "0",
    "JWT_ALGORITHM": "HS256",
    "AUTH_ACCESS_TOKEN_MINUTES": "15",
    "GOOGLE_OAUTH_CLIENT_ID": "<GOOGLE_OAUTH_CLIENT_ID>",
    "GOOGLE_OAUTH_REDIRECT_URI": "https://<worker-host>/auth/google/callback"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROUND_STREAM", "class_name": "RoundStream" }]
  },
  "migrations": [{ "tag": "round-stream-v1", "new_sqlite_classes": ["RoundStream"] }],
  "observability": { "enabled": true }
}
